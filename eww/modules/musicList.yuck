(defvar music-refreshing false)
;; ── Variable biblioteca ───────────────────────────────────────────────────────
(defpoll music-library-songs
  :interval "20s"          ; solo recarga cada 30s, no necesita ser más frecuente
  `~/.config/eww/scripts/music-library.sh`)

;; ── Ventana biblioteca ────────────────────────────────────────────────────────
(defwindow music-library
  :monitor 0
  :geometry (geometry :anchor "bottom right"
                      :x "390px"          ; justo a la izquierda del panel de música
                      :y "0px"
                      :width "340px"
                      :height "680px")
  :stacking "overlay"
  (music-library-container))

(defwidget music-library-container []
  (box :class "library-container"
       :orientation "v"
       :space-evenly false
       :spacing 0

    ;; ── Header ──────────────────────────────────────────────
    (box :class "library-header"
         :orientation "h"
         :halign "fill"
         :space-evenly false
      (label :class "library-title"
             :text "󰲸  Biblioteca"
             :hexpand true
             :xalign 0)
      (button :class "library-close-btn"
              :onclick "eww close music-library"
        (label :text "󰅖")))

    ;; ── Lista scrollable ────────────────────────────────────
    (scroll :class "library-scroll"
            :vexpand true
            :hscroll false
            :vscroll true
      (box :class "library-list"
           :orientation "v"
           :space-evenly false
           :spacing 2

        (for song in music-library-songs
          (button :class "library-item"
                  :onclick "~/.config/eww/scripts/music-play.sh '${song.file}' &"
            (box :orientation "v"
                 :space-evenly false
                 :spacing 2
              (label :class "library-item-title"
                     :text "${song.title}"
                     :xalign 0
                     :truncate true
                     :limit-width 30)
              (label :class "library-item-artist"
                     :text "${song.artist}"
                     :xalign 0
                     :truncate true
                     :limit-width 30))))))
      (button :class "music-btn music-btn-refresh"
          :tooltip "Actualizar biblioteca"
          :onclick "eww update music-refreshing=true && ~/.config/eww/scripts/music-refresh.sh && eww update music-refreshing=false &"
    (label :class {music-refreshing ? "refresh-icon spinning" : "refresh-icon"}
           :text "󰑓"))))


