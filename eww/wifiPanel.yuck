
; --- Variables de estado ---
(defvar wifi-enabled true)
(defvar wifi-menu-open false)
(defvar wifi-password-open false)
(defvar wifi-connecting-ssid "")
(defvar wifi-password-input "")

; --- Polls ---
(defpoll wifi-status-poll
  :interval "2s"
  :initial "on"
  `nmcli radio wifi 2>/dev/null || echo "unknown"`)

(defpoll wifi-ssid-poll
  :interval "2s"
  :initial "Desconectado"
  `nmcli -t -f active,ssid dev wifi 2>/dev/null | grep '^sí' || echo "Desconectado"`)

(defpoll wifi-networks-poll
  :interval "5s"
  :initial "[]"
  `python3 -c "
import subprocess, json, sys

try:
    result = subprocess.run(
        ['nmcli', '-t', '-f', 'SSID,SIGNAL,SECURITY,IN-USE', 'dev', 'wifi', 'list'],
        capture_output=True, text=True, timeout=5
    )
    networks = []
    seen = set()
    for line in result.stdout.strip().split('\n'):
        parts = line.split(':')
        if len(parts) >= 4:
            ssid     = parts[0].strip()
            signal   = parts[1].strip()
            security = parts[2].strip()
            in_use   = parts[3].strip() == '*'
            if ssid and ssid not in seen:
                seen.add(ssid)
                networks.append({
                    'ssid': ssid,
                    'signal': int(signal) if signal.isdigit() else 0,
                    'secured': bool(security and security != '--'),
                    'active': in_use
                })
    networks.sort(key=lambda x: x['signal'], reverse=True)
    print(json.dumps(networks[:8]))
except Exception as e:
    print('[]')
" 2>/dev/null || echo "[]"`)

; ============================================================
;  Ventana flotante: lista de redes WiFi
; ============================================================
(defwindow wifi-networks-window
  :monitor 0
  :geometry (geometry
    :anchor "top right"
    :x "0px"
    :y "60px"
    :width "320px"
    :height "380px")
  :stacking "overlay"
  :visible false
  (wifi-networks-popup))

; ============================================================
;  Ventana flotante: insertar contraseña
; ============================================================
(defwindow wifi-password-window
  :monitor 0
  :geometry (geometry
    :anchor "top right"
    :x "0px"
    :y "60px"
    :width "320px"
    :height "120px")
  :stacking "overlay"
  :visible false
  (wifi-password-popup))

; ============================================================
;  Widget principal: botón WiFi + botón opciones
; ============================================================
(defwidget wifi-control []
  (box
    :class "wifi-content"
    :orientation "h"
    :space-evenly false

    ; --- Botón toggle WiFi ---
    (button
      :class {wifi-status-poll == "enabled" ? "button-wifi wifi-on" : "button-wifi wifi-off"}
      :tooltip {wifi-status-poll == "enabled" ? "Desactivar WiFi" : "Activar WiFi"}
      :onclick `bash -c '
        STATUS=$(nmcli radio wifi)
        if [ "$STATUS" = "enabled" ]; then
          nmcli radio wifi off
        else
          nmcli radio wifi on
        fi'`
      (box 
        :orientation "h" 
        :space-evenly false
        (box 
          (label 
            :class "icon-wifi"
            :text {
              wifi-status-poll != "enabled" ? "󰖪" :
              wifi-ssid-poll == "Desconectado" ? "󰤫" :
              "󰖩"
            }
            :xalign 0.3))
        (box 
          :class "wifi-name-control"
          :orientation "v"
          
          (label :text "Wi-Fi" :xalign 0 :yalign 0.5)
          (label
            :text {
              wifi-status-poll != "enabled" ? "Desactivado" : 
              wifi-ssid-poll != "Desconectado" ? "Conectado":
              wifi-status-poll == "enabled" ? "Activado" :
              wifi-ssid-poll 
            }
            :class "wifi-sub-label"
            :xalign 0
            :yalign 0
            :truncate true))
      )
    )

    (box :class "separator")

    ; --- Botón opciones (despliega lista) ---
    (button 
      :class "button-wifi-options"
      :tooltip "Redes disponibles"
      :onclick `eww open-many --toggle wifi-networks-window`
      (box
        (label :class "icon-wifi-options" :text "")))
  )
)

; ============================================================
;  Popup: lista de redes disponibles
; ============================================================
(defwidget wifi-networks-popup []
  (box
    :class "wifi-popup-container"
    :orientation "v"
    :space-evenly false
    :spacing 4

    ; Cabecera
    (box
      :class "wifi-popup-header"
      :orientation "h"
      :space-evenly false
      :spacing 8
      (button
        :class "wifi-popup-close"
        :onclick `eww close wifi-networks-window`
        (label :text ""))

      (label :class "wifi-popup-title" :text "Redes Wi-Fi")
      
      )

    ; Estado del radio
    (box
      :class "wifi-popup-toggle-row"
      :orientation "h"
      :space-evenly false
      :spacing 8
      (label :text "Estado:" :class "wifi-popup-state-label")
      (label
        :text {wifi-status-poll == "enabled" ? "Activado" : "Desactivado"}
        :class {wifi-status-poll == "enabled" ? "wifi-state-on" : "wifi-state-off"})
      (box :hexpand true)
      (button
        :class {wifi-status-poll == "enabled" ? "wifi-toggle-btn on" : "wifi-toggle-btn off"}
        :onclick `bash -c 'STATUS=$(nmcli radio wifi); if [ "$STATUS" = "enabled" ]; then nmcli radio wifi off; else nmcli radio wifi on; fi'`
        (label :text {wifi-status-poll == "enabled" ? "Desactivar" : "Activar"})))

    ; Separador
    (box :class "wifi-popup-divider")

    ; Lista de redes
    (scroll
      :class "wifi-networks-scroll"
      :vscroll true
      :height 260
      (box
        :orientation "v"
        :space-evenly false
        :spacing 2
        (for net in wifi-networks-poll
          (wifi-network-row :net net))))

    ; Botón refrescar
    (button
      :class "wifi-refresh-btn"
      :onclick `nmcli dev wifi rescan 2>/dev/null &`
      (box :orientation "h" :spacing 6 :halign "center"
        (label :text "󰑓")
        (label :text "Actualizar")))
  )
)

; ============================================================
;  Fila de una red individual
; ============================================================
(defwidget wifi-network-row [net]
  (button
    :class {net.active ? "wifi-network-item active" : "wifi-network-item"}
    :onclick `bash -c '
      SSID="${net.ssid}"
      SECURED="${net.secured}"
      # Intentar conectar. Si ya tiene perfil guardado, conecta directo.
      if nmcli con show "$SSID" &>/dev/null; then
        nmcli con up "$SSID" &
      elif [ "$SECURED" = "true" ]; then
        # Señalizar que necesita contraseña: abrir ventana password
        eww update wifi-connecting-ssid="$SSID"
        eww close wifi-networks-window
        eww open wifi-password-window
      else
        nmcli dev wifi connect "$SSID" &
      fi'`
    (box
      :orientation "h"
      :space-evenly false
      :spacing 8
      :hexpand true

      ; Icono de señal
      (label
        :class "wifi-net-signal-icon"
        :text {
          net.signal >= 75 ? "󰤨" :
          net.signal >= 50 ? "󰤥" :
          net.signal >= 25 ? "󰤢" :
          "󰤟"
        })

      ; Nombre de la red
      (label
        :class "wifi-net-name"
        :text {net.ssid}
        :xalign 0
        :hexpand true
        :truncate true
        :limit-width 22)

      ; Indicador "conectado"
      (label
        :class "wifi-net-active-dot"
        :text {net.active ? "󰄬" : ""}
        :visible {net.active})

      ; Candado si requiere contraseña
      (label
        :class "wifi-net-lock-icon"
        :text {net.secured ? "󰌾" : ""}
        :visible {net.secured})
    )
  )
)

; ============================================================
;  Popup: insertar contraseña
; ============================================================
(defwidget wifi-password-popup []
  (box
    :class "wifi-popup-container wifi-password-container"
    :orientation "v"
    :space-evenly false
    :spacing 10

    ; Cabecera
    (box
      :class "wifi-popup-header"
      :orientation "h"
      :space-evenly false
      :spacing 8
      (label :class "wifi-popup-title-icon" :text "󰌾")
      (label :class "wifi-popup-title" :text "Conectar a red")
      (box :hexpand true)
      (button
        :class "wifi-popup-close"
        :onclick `eww close wifi-password-window`
        (label :text "󰅖")))

    ; SSID al que conectar
    (box :orientation "v" :spacing 4
      (label :class "wifi-pw-label" :text "Red:" :xalign 0)
      (label :class "wifi-pw-ssid" :text wifi-connecting-ssid :xalign 0))

    ; Campo contraseña (input nativo eww)
    (box :orientation "v" :spacing 4
      (label :class "wifi-pw-label" :text "Contraseña:" :xalign 0)
      (input
        :class "wifi-pw-input"
        :value wifi-password-input
        :password true
        :placeholder "Introduce la contraseña…"
        :onchange `eww update wifi-password-input={}`
        :onaccept `bash -c '
          nmcli dev wifi connect "${wifi-connecting-ssid}" password "${wifi-password-input}" &
          eww update wifi-password-input=""
          eww close wifi-password-window'`))

    ; Botones
    (box
      :orientation "h"
      :space-evenly false
      :spacing 8
      :halign "end"
      (button
        :class "wifi-pw-btn cancel"
        :onclick `bash -c 'eww update wifi-password-input=""; eww close wifi-password-window'`
        (label :text "Cancelar"))
      (button
        :class "wifi-pw-btn connect"
        :onclick `bash -c '
          nmcli dev wifi connect "${wifi-connecting-ssid}" password "${wifi-password-input}" &
          eww update wifi-password-input=""
          eww close wifi-password-window'`
        (label :text "Conectar")))
  )
)
