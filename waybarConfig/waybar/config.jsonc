//   --// waybar config generated by old the wbarconfgen script //--   //
{
    // sourced from header module //
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 28,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$HOME/.config/waybar/modules/hyprland-workspaces.jsonc",
        "$HOME/.config/waybar/modules/hyprland-window.jsonc",
        "$HOME/.config/waybar/modules/idle_inhibitor.jsonc",
        "$HOME/.config/waybar/modules/clock.jsonc",
        "$HOME/.config/waybar/modules/cpu.jsonc",
        "$HOME/.config/waybar/modules/memory.jsonc",
        "$HOME/.config/waybar/modules/temperature.jsonc",
        "$HOME/.config/waybar/modules/custom-cpufreq.jsonc",
        "$HOME/.config/waybar/modules/backlight.jsonc",
        "$HOME/.config/waybar/modules/network.jsonc",
        "$HOME/.config/waybar/modules/pulseaudio.jsonc",
        "$HOME/.config/waybar/modules/pulseaudio#microphone.jsonc",
        "$HOME/.config/waybar/modules/privacy.jsonc",
        "$HOME/.config/waybar/modules/tray.jsonc",
        "$HOME/.config/waybar/modules/battery.jsonc",
        "$HOME/.config/waybar/modules/custom-clipboard.jsonc",
        "$HOME/.config/waybar/modules/custom-control-center.jsonc",
        "$HOME/.config/waybar/modules/custom-power.jsonc"
    ],
    // positions generated based on config.ctl //
    "modules-left": [
        "group/pill#left1",
        "group/pill#left2"
    ],
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces",
            "hyprland/window"
        ]
    },
    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "idle_inhibitor",
            "clock"
        ]
    },
    "modules-center": [
        "group/pill#center"
    ],
    "group/pill#center": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
            "temperature",
            "custom/cpufreq"
        ]
    },
    "modules-right": [
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3"
    ],
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network",
            "pulseaudio",
            "pulseaudio#microphone"
        ]
    },
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "privacy",
            "tray",
            "battery"
        ]
    },
    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/clipboard",
            "custom/control-center",
            "custom/power"
        ]
    },
    "on-sigusr1": "toggle",
    "start_hidden": false
}
