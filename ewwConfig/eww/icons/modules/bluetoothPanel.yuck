; --- Variables de estado ---
(defvar bt-expanded-device "")
(defvar bt-scanning false)
(defvar bt-pw-error "")

; --- Polls ---
(defpoll bt-status-poll
  :interval "2s"
  :initial "no"
  `bluetoothctl show 2>/dev/null | awk '/Powered:/{print $2}'`)

(defpoll bt-connected-poll
  :interval "2s"
  :initial "Desconectado"
  `bluetoothctl info 2>/dev/null | awk '/Name:/{found=1; for(i=2;i<=NF;i++) printf "%s%s",$i,(i<NF?" ":""); print ""; exit} END{if(!found) print "Desconectado"}'`)

(defpoll bt-devices-poll
  :interval "4s"
  :initial "[]"
  `python3 << 'PYEOF'
import subprocess, json

def run(*args, timeout=8):
    r = subprocess.run(list(args), capture_output=True, text=True, timeout=timeout)
    return r.stdout.strip()

devices = []
seen = set()

# Iconos por tipo de dispositivo
def device_icon(dev_type, name):
    t = dev_type.lower()
    n = name.lower()
    if "audio" in t or "headphone" in n or "auricular" in n or "headset" in t:
        return "󰋋"
    if "speaker" in t or "speaker" in n or "parlante" in n or "altavoz" in n:
        return "󰓃"
    if "phone" in t or "mobile" in t:
        return "󰏲"
    if "computer" in t or "laptop" in n:
        return "󰌢"
    if "keyboard" in t or "teclado" in n:
        return "󰌌"
    if "mouse" in t or "ratón" in n:
        return "󰍽"
    if "gamepad" in t or "controller" in n or "joystick" in t:
        return "󰊗"
    return "󰂰"

try:
    # Paired devices
    paired_raw = run("bluetoothctl", "paired-devices")
    paired_macs = set()
    for line in paired_raw.splitlines():
        parts = line.split(" ", 2)
        if len(parts) >= 2:
            paired_macs.add(parts[1])

    # Connected devices
    connected_raw = run("bluetoothctl", "devices", "Connected")
    connected_macs = set()
    for line in connected_raw.splitlines():
        parts = line.split(" ", 2)
        if len(parts) >= 2:
            connected_macs.add(parts[1])

    # All known devices (paired + scanned)
    all_raw = run("bluetoothctl", "devices")
    for line in all_raw.splitlines():
        parts = line.split(" ", 2)
        if len(parts) < 3:
            continue
        mac  = parts[1]
        name = parts[2].strip()
        if not name or name == mac or mac in seen:
            continue
        seen.add(mac)

        # Get device type
        info = run("bluetoothctl", "info", mac)
        dev_type = ""
        for l in info.splitlines():
            if "Icon:" in l:
                dev_type = l.split("Icon:")[-1].strip()
                break

        paired    = mac in paired_macs
        connected = mac in connected_macs
        icon      = device_icon(dev_type, name)

        devices.append({
            "mac":       mac,
            "name":      name,
            "icon":      icon,
            "paired":    paired,
            "connected": connected,
        })

except Exception:
    pass

# Orden: conectados primero, luego vinculados, luego el resto
devices.sort(key=lambda x: (not x["connected"], not x["paired"], x["name"].lower()))
print(json.dumps(devices))
PYEOF
`)

; ============================================================
;  Ventana flotante: lista de dispositivos BT
; ============================================================
(defwindow bt-devices-window
  :monitor 0
  :geometry (geometry
    :anchor "top right"
    :x "0px"
    :y "60px"
    :width "320px"
    :height "420px")
  :stacking "overlay"
  :visible false
  (bt-devices-popup))

; ============================================================
;  Widget principal: botón BT + botón opciones
; ============================================================
(defwidget bluetooth-control []
  (box
    :class "bluetooth-content"
    :orientation "h"
    :space-evenly false

    (button
      :class {bt-status-poll == "yes" ? "button-bluetooth bt-on" : "button-bluetooth bt-off"}
      :tooltip {bt-status-poll == "yes" ? "Desactivar Bluetooth" : "Activar Bluetooth"}

      :onclick `bash -c '
        STATUS=$(bluetoothctl show | awk "/Powered:/{print \$2}")
        if [ "$STATUS" = "yes" ]; then
          bluetoothctl power off
        else
          bluetoothctl power on
        fi'`
      (box
        :orientation "h"
        :space-evenly false
        (box
          (label
            :class "icon-bluetooth"
            :text {bt-status-poll == "yes" ? "󰂯" : "󰂲"}
            :xalign 0.3))
        (box
          :class "bluetooth-name-control"
          :orientation "v"
          (label :text "Bluetooth" :xalign 0 :yalign 0.5)
          (label
            :text {
              bt-status-poll != "yes" ? "Desactivado" :
              bt-connected-poll == "Desconectado" ? "Sin conexión" :
              bt-connected-poll
            }
            :class "bt-sub-label"
            :xalign 0
            :yalign 0
            :truncate true
            :limit-width 14))
      )
    )

    (box :class "separator")

    (button
      :class "button-bluetooth-options"
      :tooltip "Dispositivos Bluetooth"
      :onclick `eww open-many --toggle bt-devices-window`
      (box
        (label :class "icon-bluetooth-options" :text "")))
  )
)

; ============================================================
;  Popup: lista de dispositivos
; ============================================================
(defwidget bt-devices-popup []
  (box
    :class "bt-popup-container"
    :orientation "v"
    :space-evenly false
    :spacing 4

    ; Cabecera
    (box
      :class "bt-popup-header"
      :orientation "h"
      :space-evenly false
      :spacing 8
      (button
        :class "bt-popup-close"
        :onclick `bash -c '
          eww update bt-expanded-device=""
          eww update bt-scanning=false
          eww close bt-devices-window'`
        (label :text ""))
      (label :class "bt-popup-title" :text "Bluetooth"))

    ; Estado del adaptador
    (box
      :class "bt-popup-toggle-row"
      :orientation "h"
      :space-evenly false
      :spacing 8
      (label :text "Estado:" :class "bt-popup-state-label")
      (label
        :text {bt-status-poll == "yes" ? "Activado" : "Desactivado"}
        :class {bt-status-poll == "yes" ? "bt-state-on" : "bt-state-off"})
      (box :hexpand true)
      (button
        :class {bt-status-poll == "yes" ? "bt-toggle-btn on" : "bt-toggle-btn off"}
        :onclick `bash -c '
          STATUS=$(bluetoothctl show | awk "/Powered:/{print \$2}")
          if [ "$STATUS" = "yes" ]; then
            bluetoothctl power off
          else
            bluetoothctl power on
          fi'`
        (label :text {bt-status-poll == "yes" ? "Desactivar" : "Activar"})))

    ; Separador
    (box :class "bt-popup-divider")

    ; Lista de dispositivos
    (scroll
      :class "bt-devices-scroll"
      :vscroll true
      :height 280
      (box
        :orientation "v"
        :space-evenly false
        :spacing 2

        ; Sección: vinculados/conectados
        (box
          :class "bt-section-header"
          :visible {bt-devices-poll != "[]"}
          (label :text "Dispositivos" :class "bt-section-label"))

        (for dev in bt-devices-poll
          (bt-device-row :dev dev))

        ; Mensaje vacío
        (box
          :class "bt-empty-msg"
          :visible {bt-devices-poll == "[]"}
          :halign "center"
          (label :text "No hay dispositivos conocidos" :class "bt-empty-label"))))

    ; Botones de acción inferiores
    (box
      :class "bt-actions-row"
      :orientation "h"
      :space-evenly true
      :spacing 6

      ; Buscar dispositivos
      (button
        :class {bt-scanning ? "bt-scan-btn scanning" : "bt-scan-btn"}
        :tooltip "Buscar dispositivos cercanos"
        :onclick `bash -c '
          if [ "${bt-scanning}" = "true" ]; then
            bluetoothctl scan off 2>/dev/null &
            eww update bt-scanning=false
          else
            eww update bt-scanning=true
            bluetoothctl scan on 2>/dev/null &
            sleep 10
            bluetoothctl scan off 2>/dev/null &
            eww update bt-scanning=false
          fi &'`
        (box :orientation "h" :spacing 6 :halign "center"
          (label :text {bt-scanning ? "󰑓" : "󰍡"} :class {bt-scanning ? "bt-scan-icon spinning" : "bt-scan-icon"})
          (label :text {bt-scanning ? "Buscando…" : "Buscar"})))
    )
  )
)

; ============================================================
;  Fila de un dispositivo individual
; ============================================================
(defwidget bt-device-row [dev]
  (box
    :orientation "v"
    :space-evenly false
    :spacing 0

    ; Botón principal del dispositivo
    (button
      :class {dev.connected ? "bt-device-item connected" : dev.paired ? "bt-device-item paired" : "bt-device-item"}
      :onclick `bash -c '
        MAC="${dev.mac}"
        PAIRED="${dev.paired}"
        CONNECTED="${dev.connected}"
        EXPANDED="${bt-expanded-device}"

        # Toggle: si ya está expandido, cerrar
        if [ "$EXPANDED" = "$MAC" ]; then
          eww update bt-expanded-device=""
          exit 0
        fi

        # Si ya está conectado → desconectar directo
        if [ "$CONNECTED" = "true" ]; then
          bluetoothctl disconnect "$MAC" &
          exit 0
        fi

        # Si está vinculado → conectar directo
        if [ "$PAIRED" = "true" ]; then
          bluetoothctl connect "$MAC" &
          exit 0
        fi

        # Dispositivo nuevo → expandir opciones
        eww update bt-expanded-device="$MAC"'`

      (box
        :orientation "h"
        :space-evenly false
        :spacing 8
        :hexpand true

        ; Icono tipo dispositivo
        (label
          :class "bt-device-type-icon"
          :text {dev.icon})

        ; Nombre
        (label
          :class "bt-device-name"
          :text {dev.name}
          :xalign 0
          :hexpand true
          :truncate true
          :limit-width 20)

        ; Badge: conectado
        (label
          :class "bt-device-connected-dot"
          :text "󰄬"
          :visible {dev.connected})

        ; Badge: vinculado pero no conectado
        (label
          :class "bt-device-paired-icon"
          :text "󰌾"
          :visible {dev.paired && !dev.connected})
      )
    )

    ; Panel inline de opciones (solo para dispositivos no vinculados aún)
    (revealer
      :transition "slidedown"
      :duration "200ms"
      :reveal {bt-expanded-device == dev.mac}

      (box
        :class "bt-inline-options-box"
        :orientation "v"
        :space-evenly false
        :spacing 6

        ; Info del dispositivo
        (box :orientation "h" :spacing 6 :space-evenly false
          (label :class "bt-opt-label" :text "MAC:" :xalign 0)
          (label :class "bt-opt-mac" :text {dev.mac} :xalign 0 :hexpand true))

        ; Mensaje de error si hay
        (box
          :class "bt-pw-error-box"
          :visible {bt-pw-error != ""}
          :orientation "h"
          :spacing 6
          (label :class "bt-pw-error-icon" :text "󰀦")
          (label
            :class "bt-pw-error-msg"
            :text bt-pw-error
            :xalign 0
            :wrap true))

        ; Botones de acción
        (box
          :orientation "h"
          :space-evenly false
          :spacing 6
          :halign "end"

          ; Cancelar / cerrar panel
          (button
            :class "bt-opt-btn cancel"
            :onclick `eww update bt-expanded-device=""`
            (label :text "Cancelar"))

          ; Vincular
          (button
            :class "bt-opt-btn pair"
            :visible {!dev.paired}
            :onclick `bash -c '
              MAC="${dev.mac}"
              eww update bt-expanded-device=""
              bluetoothctl pair "$MAC" &' &`
            (box :orientation "h" :spacing 4
              (label :text "󰌾")
              (label :text "Vincular")))

          ; Conectar (si ya está vinculado pero desconectado)
          (button
            :class "bt-opt-btn connect"
            :visible {dev.paired && !dev.connected}
            :onclick `bash -c '
              MAC="${dev.mac}"
              eww update bt-expanded-device=""
              bluetoothctl connect "$MAC" &' &`
            (box :orientation "h" :spacing 4
              (label :text "󰂯")
              (label :text "Conectar")))

          ; Desconectar
          (button
            :class "bt-opt-btn disconnect"
            :visible {dev.connected}
            :onclick `bash -c '
              MAC="${dev.mac}"
              eww update bt-expanded-device=""
              bluetoothctl disconnect "$MAC" &' &`
            (box :orientation "h" :spacing 4
              (label :text "󰂲")
              (label :text "Desconectar")))

          ; Desvincular / olvidar
          (button
            :class "bt-opt-btn remove"
            :visible {dev.paired}
            :onclick `bash -c '
              MAC="${dev.mac}"
              eww update bt-expanded-device=""
              bluetoothctl remove "$MAC" &' &`
            (box :orientation "h" :spacing 4
              (label :text "󰩈")
              (label :text "Olvidar")))
        )
      )
    )
  )
)
