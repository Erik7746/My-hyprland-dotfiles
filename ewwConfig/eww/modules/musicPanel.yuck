(defvar bar1  2)
(defvar bar2  2)
(defvar bar3  2)
(defvar bar4  2)
(defvar bar5  2)
(defvar bar6  2)
(defvar bar7  2)
(defvar bar8  2)
(defvar bar9  2)
(defvar bar10 2)


(deflisten bars_data
  :initial '{"b1":2,"b2":2,"b3":2,"b4":2,"b5":2,"b6":2,"b7":2,"b8":2,"b9":2,"b10":2}'
  `bash ~/.config/eww/scripts/cava-listen.sh`)

; --- Barra individual ---
(defwidget cava-bar [height]
  (box
    :class "cava-bar-wrapper"
    :valign "end"
    :width 8
    :height 80
    (box
      :class "cava-bar"
      :valign "end"
      :width 6
      :height height)))
      
; --- Lado izquierdo
(defwidget cava-left []
  (box
    :orientation "h"
    :space-evenly false
    :valign "end"
    :spacing 2
    (cava-bar :height {bars_data.b1})
    (cava-bar :height {bars_data.b2})
    (cava-bar :height {bars_data.b3})
    (cava-bar :height {bars_data.b4})
    (cava-bar :height {bars_data.b5})
    (cava-bar :height {bars_data.b6})
    (cava-bar :height {bars_data.b7})
    (cava-bar :height {bars_data.b8})
    (cava-bar :height {bars_data.b9})
    (cava-bar :height {bars_data.b10})))

; --- Lado derecho
(defwidget cava-right []
  (box
    :orientation "h"
    :space-evenly false
    :valign "end"
    :spacing 2
    (cava-bar :height {bars_data.b10})
    (cava-bar :height {bars_data.b9})
    (cava-bar :height {bars_data.b8})
    (cava-bar :height {bars_data.b7})
    (cava-bar :height {bars_data.b6})
    (cava-bar :height {bars_data.b5})
    (cava-bar :height {bars_data.b4})
    (cava-bar :height {bars_data.b3})
    (cava-bar :height {bars_data.b2})
    (cava-bar :height {bars_data.b1})))

; --- Visualizador completo: izq + espejo ---
(defwidget cava-visualizer []
  (box
    :class "cava-visualizer"
    :orientation "h"
    :space-evenly false
    :valign "end"
    :halign "center"
    :spacing 1
    (cava-left)
    (box :class "cava-mirror-gap" )
    (cava-right)))

;; ============================================================
;;  VARIABLES MPD
;; ============================================================
(defpoll music-title
  :interval "2s"
  `mpc -f "%title%" current 2>/dev/null | head -1 || echo "Sin música"`)

(defpoll music-artist
  :interval "2s"
  `mpc -f "%artist%" current 2>/dev/null | head -1 || echo "Desconocido"`)

(defpoll music-cover
  :interval "2s"
  `~/.config/eww/scripts/music-cover.sh`)

(defpoll music-progress-val
  :interval "1s"
  `~/.config/eww/scripts/music-progress.sh`)

(defpoll music-play-icon
  :interval "1s"
  `~/.config/eww/scripts/music-status.sh`)

(defpoll music-time
  :interval "1s"
  `~/.config/eww/scripts/music-time.sh`)
(defpoll music-bg
  :interval "2s"
  `~/.config/eww/scripts/music-bg.sh`)
(defpoll music-mode
  :interval "1s"
  `~/.config/eww/scripts/music-mode-get.sh`)

;; ============================================================
;;  WIDGET MUSIC-CONTAINER
;; ============================================================
(defwidget music-container []
    (box :class "music-container"
        :orientation "v"
        :style "background-image: url('${music-bg}'); background-position: center;"
        :space-evenly false
        :spacing 1

      ;; ── Portada + Info + Visualizador ──────────────────────
      (box :orientation "v"
          :space-evenly false
          :spacing 12
          :valign "start"

        (box :class "panel-music-front"
              :style "background-image: url('${music-cover}'); background-position: center;")

        (box :orientation "v"
            :valign "center"
            :hexpand true
            :space-evenly false
          (label :class "music-title"
                :text music-title
                :xalign 0
                :truncate true
                :limit-width 28)
          (label :class "music-artist"
                :text music-artist
                :xalign 0
                :truncate true
                :limit-width 28))

        (cava-visualizer))

      ;; ── Barra de progreso ──────────────────────────────────
      (box :orientation "v"
          :hexpand true
          :space-evenly false
          :spacing 4
          :class "music-progress-box"

        (scale :class "music-progress-bar"
              :orientation "h"
              :hexpand true
              :min 0
              :max 100
              :value music-progress-val
              :onchange "mpc seek {}% > /dev/null")

        (box :orientation "h"
            :hexpand true
            :halign "fill"
            :space-evenly false
          (label :class "music-time"
                :text music-time
                :halign "center"
                :hexpand true)))
      ;; ── Controles ─────────────────────────────────────────
      (box :orientation "h"
          :halign "center"
          :space-evenly true
          :spacing 20
          :valign "end"
          :vexpand true

        (button :class "music-btn music-btn-mode music-btn-mode-${music-mode}"
          :onclick "~/.config/eww/scripts/music-mode-toggle.sh"
          :tooltip "${music-mode}"
          (label :text {music-mode == "repeat" ? "󰑖" : music-mode == "random" ? "󰒞" : "󰑘"}))

        (button :class "music-btn"
                :onclick "mpc prev > /dev/null"
          (label :text "󰒮"))

        (button :class "music-btn music-btn-play"
                :onclick "mpc toggle > /dev/null"
          (label :text music-play-icon))

        (button :class "music-btn"
                :onclick "mpc next > /dev/null"
          (label :text "󰒭"))
        (button :class "music-btn music-btn-playlist"
              :onclick "eww open-many music-library --toggle"
        (label :text "󰲸")))))


(defwindow music-panel
  :monitor 0
  :geometry (geometry :anchor "bottom right"
                      :x "0px" :y "0px"
                      :width "340px" :height "680px")
  :stacking "overlay"
  (music-container))